# 複製成 .env 後填入真實值，再執行 docker compose up -d
# cp .env.example .env

# PostgreSQL 密碼（docker-compose.yml 讀取此值）
POSTGRES_PASSWORD=請改成強密碼

# Gmail 寄件帳號（用於寄送驗證信與重設密碼信）
# 需要先在 Google 帳號開啟「兩步驟驗證」並產生「應用程式密碼」
# 注意：程式（main.py）讀取的是 OASIS_ 前綴的變數，不要寫成 EMAIL_USER / EMAIL_PASS
OASIS_EMAIL_USER=your-email@gmail.com
OASIS_EMAIL_PASS=your-app-password
# 驗證信／重設密碼信裡連結用的網站網址（正式環境改成你的網域）
OASIS_SITE_URL=http://localhost:8000

# Gunicorn worker 數量（預設 4，可視伺服器 CPU 數調整）
WORKERS=4

# Sentry 錯誤追蹤 DSN（留空 = 停用）
# 取得方式：https://sentry.io → 新建 Python 專案 → Settings → DSN
SENTRY_DSN=
SENTRY_ENV=production

# SQLite 資料庫檔案路徑（預設 oasis.db；測試時自動覆寫為 oasis_test.db）
# 使用 PostgreSQL 時此設定無效（由 DATABASE_URL 決定）
SQLITE_DB=oasis.db
